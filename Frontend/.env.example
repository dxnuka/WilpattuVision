# Copy this file to .env and fill in your actual values.
# Vite only exposes variables prefixed with VITE_ to client code.

# --- Firebase (Project settings > General > Your apps > SDK setup) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# ^ VITE_FIREBASE_STORAGE_BUCKET is unused (file storage runs on Cloudinary
# now, see below) but harmless to leave filled in from your Firebase config.

# --- FastAPI backend ---
# Leave as /api in development (proxied to localhost:8000 by vite.config.js).
# Set to your deployed backend URL in production (e.g. Render/Railway URL).
VITE_API_BASE_URL=/api

# --- Google Maps JavaScript API ---
# Google Cloud Console > APIs & Services > Credentials.
# Enable the "Maps JavaScript API" for the project, then restrict the key
# to your domain(s) (HTTP referrer restriction) before shipping.
VITE_GOOGLE_MAPS_API_KEY=

# --- Cloudinary (file storage — sighting photos, profile pictures, etc.) ---
# cloudinary.com > free plan, no card required. Dashboard shows Cloud Name.
# Settings > Upload > Add upload preset > set Signing Mode to "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
